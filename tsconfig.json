{
  "compilerOptions": {
    "allowJs": false,
    "isolatedModules": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["vite/client", "node"],
    "useDefineForClassFields": true
  },
  "include": [
    "assets/**/*.ts",
    "assets/**/*.vue",
    "vite.config.ts"
  ]
}
